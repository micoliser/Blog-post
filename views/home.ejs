<%- include("partials/header"); -%>

<div class="intro">
  <div class="intro-content">
    <h2>Welcome to BlogPost!</h2>
    <p>
      Share your stories, connect with others, and explore new ideas.<br />
      Start writing or browse the latest posts below.
    </p>
    <a href="/compose" class="btn-intro">Create a New Post</a>
  </div>
</div>

<section class="posts">
  <% posts.forEach((post) => { %>
  <div class="post">
    <h3><%= post.title %></h3>
    <p class="post-time">by <%= post.posterName %> at <%= post.time %></p>
    <p>
      <%= post.content.slice(0, 100) + " ..." %><a href="/posts/<%= post._id %>"
        >Read More</a
      >
    </p>
    <% if (post.posterId === id) { %>
    <form action="/delete-post" method="post">
      <input type="hidden" name="postId" value="<%= post._id %>" />
      <button class="delete" type="submit" name="button">Delete</button>
    </form>
    <% } %>
  </div>
  <% }); %>
</section>

<%- include("partials/footer"); -%>
